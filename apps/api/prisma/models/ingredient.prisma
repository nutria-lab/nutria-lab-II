enum IngredientType {
  MEAT
  VEGETABLE
  FRUIT
  DAIRY
  GRAIN
  SPICE
  OTHER
}

model Ingredient {
  id                String             @id @default(uuid())
  name              String             @unique
  type              IngredientType
  nutritionalValues Json
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}
