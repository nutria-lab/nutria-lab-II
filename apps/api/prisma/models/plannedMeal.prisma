
model PlannedMeal {
  id        String      @id @default(uuid())
  dayId     String
  day       MealPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  mealType  MealType
  recipeId  String
  recipe    Recipe      @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  servings  Int?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("planned_meals")
}