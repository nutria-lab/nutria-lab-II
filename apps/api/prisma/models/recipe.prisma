model Recipe {
  id           String             @id @default(uuid())
  title        String
  description  String?
  prepMinutes  Int
  cookMinutes  Int
  servings     Int
  instructions String[]
  imageUrl     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ingredients  RecipeIngredient[]
  plannedMeals PlannedMeal[]

  @@map("recipes")
}