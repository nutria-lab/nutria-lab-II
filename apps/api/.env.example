DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
GEMINI_API_KEY="your-google-ai-studio-key"
# Comma-separated exact web origins. Production must set HTTPS stable web origins.
CORS_ORIGINS="http://localhost:5173"
# Minutos que un reemplazo de comida puede quedar en curso antes de considerarse colgado (default 10).
MEAL_REPLACEMENT_PENDING_TTL_MINUTES="10"
