DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
GEMINI_API_KEY="your-google-ai-studio-key"
# Comma-separated exact web origins. Production must set HTTPS stable web origins.
CORS_ORIGINS="http://localhost:5173"
# Unsplash Access Key only (public search auth). Never the Secret Key.
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
