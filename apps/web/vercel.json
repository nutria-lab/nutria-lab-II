{
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm format && pnpm lint && pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nutria-lab-ii-api.vercel.app/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
